diff --git a/pkg/reversesshfs/rooted_relay.go b/pkg/reversesshfs/rooted_relay.go
new file mode 100644
index 0000000..91cdfe0
--- /dev/null
+++ b/pkg/reversesshfs/rooted_relay.go
@@ -0,0 +1,159 @@
+//go:build linux || darwin || windows
+
+package reversesshfs
+
+import (
+	"errors"
+	"io/fs"
+	"time"
+)
+
+// noopRemovalTTL bounds how long an ExpectRemove token waits for the guest.
+const noopRemovalTTL = 5 * time.Second
+
+// ownRemovalTTL bounds how long a removal made by the server hides the host's event for it.
+const ownRemovalTTL = 2 * time.Second
+
+// maxRelayEntries bounds each table, whatever the host does.
+const maxRelayEntries = 1 << 20
+
+// expiring is a set of keys that each expire ttl after being added. Entries
+// are queued in the order they expire, so purging costs O(1) per entry.
+type expiring struct {
+	ttl   time.Duration
+	m     map[string]time.Time
+	q     []expiringKey
+	front int
+}
+
+type expiringKey struct {
+	key    string
+	expiry time.Time
+}
+
+func newExpiring(ttl time.Duration) *expiring {
+	return &expiring{ttl: ttl, m: make(map[string]time.Time)}
+}
+
+// add reports false when the set is full.
+func (e *expiring) add(key string, now time.Time) bool {
+	e.purge(now)
+	if len(e.q)-e.front >= maxRelayEntries {
+		return false
+	}
+	expiry := now.Add(e.ttl)
+	e.m[key] = expiry
+	e.q = append(e.q, expiringKey{key, expiry})
+	return true
+}
+
+func (e *expiring) has(key string, now time.Time) bool {
+	e.purge(now)
+	_, ok := e.m[key]
+	return ok
+}
+
+// remove reports whether key was there. Its queue entry stays until it expires.
+func (e *expiring) remove(key string, now time.Time) bool {
+	ok := e.has(key, now)
+	delete(e.m, key)
+	return ok
+}
+
+func (e *expiring) purge(now time.Time) {
+	for e.front < len(e.q) && !now.Before(e.q[e.front].expiry) {
+		k := e.q[e.front]
+		// A key added again has a later expiry, and its own queue entry.
+		if e.m[k.key].Equal(k.expiry) {
+			delete(e.m, k.key)
+		}
+		e.q[e.front] = expiringKey{}
+		e.front++
+	}
+	if e.front >= 1024 && e.front*2 >= len(e.q) {
+		e.q = append(e.q[:0], e.q[e.front:]...)
+		e.front = 0
+	}
+}
+
+// relay is the state behind ExpectRemove.
+//
+// The hostagent relays a deletion made on the host by having the guest remove the path, which
+// makes the guest emit an event. The server must then answer that removal without touching the host:
+// the path may have been created again there since. Two things must not be mistaken for it:
+// the host's event for a removal that the guest itself asked for, and a removal of a path the
+// guest created after the host deleted it.
+type relay struct {
+	tokens *expiring // paths whose next removal is the relayed one
+	own    *expiring // paths the server just removed or renamed away
+}
+
+func newRelay() *relay {
+	return &relay{tokens: newExpiring(noopRemovalTTL), own: newExpiring(ownRemovalTTL)}
+}
+
+// expectRemove makes the next Remove or Rmdir request for p, within noopRemovalTTL, succeed without
+// touching the host, and reports true. p is a host path under the root. It reports false, and
+// the removal must not be relayed, when the server removed p itself just now.
+func (h *rootedHandlers) expectRemove(p string) bool {
+	rel, err := h.rel(slashPath(p))
+	if err != nil {
+		return false
+	}
+	now := h.now()
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if h.relay.own.has(rel, now) {
+		return false
+	}
+	return h.relay.tokens.add(rel, now)
+}
+
+func (h *rootedHandlers) consumeNoopRemoval(p string) bool {
+	rel, err := h.rel(p)
+	if err != nil {
+		return false
+	}
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	return h.relay.tokens.remove(rel, h.now())
+}
+
+// removing records that the server is about to remove or move away p, a request path.
+// This is before the removal, as the host's event can come right after it.
+func (h *rootedHandlers) removing(p string) {
+	rel, err := h.rel(p)
+	if err != nil {
+		return
+	}
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	h.relay.own.add(rel, h.now())
+}
+
+// removalFailed takes back removing(p) when the removal or move did not happen: nothing of the host's
+// changed, so a later deletion of p there is not the server's own. A path that was not there stays: an
+// earlier removal of it may be the one the host's event is about.
+func (h *rootedHandlers) removalFailed(p string, err error) error {
+	if err == nil || errors.Is(err, fs.ErrNotExist) {
+		return err
+	}
+	if rel, rerr := h.rel(p); rerr == nil {
+		h.mu.Lock()
+		h.relay.own.remove(rel, h.now())
+		h.mu.Unlock()
+	}
+	return err
+}
+
+// creating records that the server is about to create p, a request path: a removal of it that follows
+// is the guest's own, not a relayed one.
+func (h *rootedHandlers) creating(p string) {
+	rel, err := h.rel(p)
+	if err != nil {
+		return
+	}
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	h.relay.tokens.remove(rel, h.now())
+}
diff --git a/pkg/reversesshfs/rooted_relay_test.go b/pkg/reversesshfs/rooted_relay_test.go
new file mode 100644
index 0000000..386da54
--- /dev/null
+++ b/pkg/reversesshfs/rooted_relay_test.go
@@ -0,0 +1,158 @@
+//go:build linux || darwin || windows
+
+package reversesshfs
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+// A removal the server made for the guest is not relayed: the host's event for it must not
+// leave a token that swallows the guest's next removal of a file it created again.
+func TestRootedOwnRemovalNotRelayed(t *testing.T) {
+	c, root, h := setupRootedHandlers(t, false)
+	p := func(s string) string { return filepath.Join(root, s) }
+	create := func(s string) {
+		t.Helper()
+		f, err := c.Create(p(s))
+		if err != nil {
+			t.Fatal(err)
+		}
+		f.Close()
+	}
+	create("f")
+	if err := c.Remove(p("f")); err != nil {
+		t.Fatal(err)
+	}
+	if h.expectRemove(p("f")) {
+		t.Fatal("the host's event for the guest's own removal was relayed")
+	}
+	create("f")
+	if err := c.Remove(p("f")); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Lstat(p("f")); err == nil {
+		t.Fatal("rm f; touch f; rm f left the file on the host")
+	}
+
+	// A rename away is a removal as well: log rotation.
+	create("log")
+	if err := c.PosixRename(p("log"), p("log.1")); err != nil {
+		t.Fatal(err)
+	}
+	create("log")
+	if h.expectRemove(p("log")) {
+		t.Fatal("the host's event for the guest's rename was relayed")
+	}
+	if err := c.Remove(p("log")); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Lstat(p("log")); err == nil {
+		t.Fatal("the new log was not removed")
+	}
+
+	// Once the event window is over, a host deletion is relayed again.
+	now := time.Now()
+	h.now = func() time.Time { return now.Add(ownRemovalTTL + time.Second) }
+	if !h.expectRemove(p("log")) {
+		t.Error("not relayed after the window")
+	}
+}
+
+// A removal that fails removed nothing: the host's deletion of the path that follows is still relayed.
+func TestRootedFailedRemovalNotOwn(t *testing.T) {
+	c, root, h := setupRootedHandlers(t, false)
+	p := func(s string) string { return filepath.Join(root, s) }
+	if err := os.MkdirAll(p("d/sub"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := c.RemoveDirectory(p("d")); err == nil {
+		t.Fatal("a folder with something in it was removed")
+	}
+	if !h.expectRemove(p("d")) {
+		t.Error("a removal that failed hid the host's deletion")
+	}
+}
+
+// A file the guest creates after the host deleted it, within the token's life, is its own.
+func TestRootedTokenDroppedByCreate(t *testing.T) {
+	c, root, h := setupRootedHandlers(t, false)
+	p := func(s string) string { return filepath.Join(root, s) }
+	if !h.expectRemove(p("new")) {
+		t.Fatal("not expected")
+	}
+	f, err := c.Create(p("new"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	f.Close()
+	if err := c.Remove(p("new")); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := os.Lstat(p("new")); err == nil {
+		t.Fatal("the removal was swallowed though the guest created the file")
+	}
+
+	// Same for the other ways to create a name.
+	for name, create := range map[string]func(string) error{
+		"mkdir":   func(s string) error { return c.Mkdir(s) },
+		"symlink": func(s string) error { return c.Symlink("x", s) },
+		"rename":  func(s string) error { return c.PosixRename(p("src/main.go"), s) },
+	} {
+		target := p("t-" + name)
+		h.expectRemove(target)
+		if err := create(target); err != nil {
+			t.Fatal(name, err)
+		}
+		if err := c.Remove(target); err != nil {
+			if err := c.RemoveDirectory(target); err != nil {
+				t.Fatal(name, err)
+			}
+		}
+		if _, err := os.Lstat(target); err == nil {
+			t.Errorf("%s: the removal was swallowed", name)
+		}
+	}
+}
+
+// A host rm -rf of many files must not stall the server.
+func TestExpectRemoveMany(t *testing.T) {
+	_, root, h := setupRootedHandlers(t, false)
+	start := time.Now()
+	const n = 200000
+	for i := 0; i < n; i++ {
+		h.expectRemove(filepath.Join(root, "src", fmt.Sprint(i)))
+	}
+	if d := time.Since(start); d > 5*time.Second {
+		t.Fatalf("%d tokens took %v", n, d)
+	}
+	// They expire in order, and the tables empty out.
+	now := time.Now()
+	h.now = func() time.Time { return now.Add(noopRemovalTTL + time.Second) }
+	h.expectRemove(filepath.Join(root, "x"))
+	h.mu.Lock()
+	defer h.mu.Unlock()
+	if len(h.relay.tokens.m) != 1 {
+		t.Errorf("%d tokens left", len(h.relay.tokens.m))
+	}
+}
+
+func TestExpiringKeyAddedAgain(t *testing.T) {
+	e := newExpiring(10 * time.Second)
+	t0 := time.Now()
+	e.add("k", t0)
+	e.add("k", t0.Add(8*time.Second))
+	// The first entry expired, the key is still there with the later expiry.
+	if !e.has("k", t0.Add(12*time.Second)) {
+		t.Error("key added again was purged by its first entry")
+	}
+	if e.has("k", t0.Add(19*time.Second)) {
+		t.Error("key not expired")
+	}
+	if len(e.m) != 0 {
+		t.Error("left over")
+	}
+}
