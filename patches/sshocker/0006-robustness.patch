+// Directories are listed as the client asks, and the handle's descriptor is released on close.
+func TestRootedListLarge(t *testing.T) {
+	c, root := setupRooted(t, false)
+	dir := filepath.Join(root, "src", "many")
+	if err := os.Mkdir(dir, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	const n = 1234
+	for i := 0; i < n; i++ {
+		if err := os.WriteFile(filepath.Join(dir, fmt.Sprintf("f%04d", i)), nil, 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+	before := openFDs()
+	for i := 0; i < 3; i++ {
+		fis, err := c.ReadDir(dir)
+		if err != nil || len(fis) != n {
+			t.Fatalf("ReadDir: %d entries, %v", len(fis), err)
+		}
+		seen := make(map[string]bool, n)
+		for _, fi := range fis {
+			seen[fi.Name()] = true
+		}
+		if len(seen) != n {
+			t.Fatalf("%d distinct entries", len(seen))
+		}
+	}
+	if after := openFDs(); after > before {
+		t.Fatalf("descriptors: %d before, %d after", before, after)
+	}
+}
+
+// openFDs counts the descriptors of this process, or returns 0 where it cannot.
+func openFDs() int {
+	fis, err := os.ReadDir("/proc/self/fd")
+	if err != nil {
+		return 0
+	}
+	return len(fis)
+}
