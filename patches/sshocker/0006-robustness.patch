+func TestRootedMaxHandles(t *testing.T) {
+	c, root := setupRooted(t, false)
+	p := filepath.Join(root, "src", "main.go")
+	files := make([]*sftp.File, 0, maxHandles)
+	defer func() {
+		for _, f := range files {
+			f.Close()
+		}
+	}()
+	for i := 0; i < maxHandles; i++ {
+		f, err := c.Open(p)
+		if err != nil {
+			t.Fatalf("handle %d: %v", i, err)
+		}
+		files = append(files, f)
+	}
+	if f, err := c.Open(p); err == nil {
+		f.Close()
+		t.Fatal("one handle over the limit")
+	}
+	files[0].Close()
+	files = files[1:]
+	f, err := c.Open(p)
+	if err != nil {
+		t.Fatal(err)
+	}
+	files = append(files, f)
+}
